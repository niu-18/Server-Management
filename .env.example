# 复制成 .env 后按需修改（.env 不要提交）

# 采集用的 SSH 私钥；默认用 npm run install-key 生成的那把
SSH_KEY=~/.ssh/srvman_ed25519

# 后端端口（前端 vite 会把 /api 代理到这里）
API_PORT=8787

# 单台常规采集超时（毫秒）
COLLECT_TIMEOUT=120000
# 扫共享存储那台的超时（du 整份 NAS 实测约 10 秒）
NAS_COLLECT_TIMEOUT=300000
# SSH 连接超时
SSH_CONNECT_TIMEOUT=15000

# 同时并发采集几台
COLLECT_CONCURRENCY=9

# 只让这一台去 du 共享存储（9 台挂的是同一份，重复扫没意义）
NAS_SCANNER=s0

# 设成 0 就禁用 lxc exec + df 降级（那样停着的容器会直接显示未取到）
# CONTAINER_DF_FALLBACK=0

# 设为 1 时用假数据渲染界面，方便调 UI（不连任何服务器）
# MOCK=1

# 容器终端：空闲多少毫秒后自动断开（容器里的 tmux 会话不受影响，重连即接回）
# TERMINAL_IDLE_MS=1800000

# 单次体检的总超时（一个容器 9 项检查，正常 4–6 秒）
# CHECK_TIMEOUT=180000

# 打开后 UI 还能拿到宿主机 shell（能直接动 LXD 和别人机器，默认关）
# ALLOW_HOST_TERMINAL=1

# 端口连通性探测：单个端口等多久（毫秒），以及网关地址
# PORT_PROBE_TIMEOUT=2500
# GATEWAY_HOST=10.0.0.10

# 备用：不想用密钥时可以在这里放密码（后端优先用密钥）
# 注意：这样密码会落盘，一般不建议
# SSH_PASSWORD=
